rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function userDataWriteAllowed(userId) {
      return !exists(/databases/$(database)/documents/authCredentials/$(userId)) ||
        get(/databases/$(database)/documents/authCredentials/$(userId)).data.deletionStartedAt == null;
    }

    // 모든 사용자 데이터는 users 컬렉션 아래에 위치
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId &&
        userDataWriteAllowed(userId);

      // 개발 목표를 제외한 서브 컬렉션까지 모두 적용
      match /{collectionId}/{document=**} {
        allow read: if collectionId != 'developmentGoals' &&
          request.auth != null && request.auth.uid == userId;
        allow write, delete: if collectionId != 'developmentGoals' &&
          request.auth != null && request.auth.uid == userId &&
          userDataWriteAllowed(userId);
      }

      // 개발 목표의 생성과 상태 전환, 완료된 목표의 제목과 설명 수정
      match /developmentGoals/{goalId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId &&
          userDataWriteAllowed(userId) &&
          request.resource.data.get('status', null) != 'completed';
        // 완료된 목표는 상태를 유지한 채 제목, 설명, 갱신 시각만 바꾸는 갱신 허용
        allow update: if request.auth != null && request.auth.uid == userId &&
          userDataWriteAllowed(userId) &&
          (
            request.resource.data.get('status', null) != 'completed' ||
            (
              resource.data.get('status', null) == 'completed' &&
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['title', 'markdownDescription', 'updatedAt'])
            )
          );

        // 개발 기록의 생성과 초안, 현재 확정 버전 참조 갱신
        match /records/{recordId} {
          allow read: if request.auth != null && request.auth.uid == userId;
          allow create, update: if request.auth != null && request.auth.uid == userId &&
            userDataWriteAllowed(userId);

          // 확정 버전은 생성만 허용하고 갱신과 삭제는 항상 거부
          match /versions/{versionId} {
            allow read: if request.auth != null && request.auth.uid == userId;
            allow create: if request.auth != null && request.auth.uid == userId &&
              userDataWriteAllowed(userId);
          }
        }
      }
    }

  }
}
